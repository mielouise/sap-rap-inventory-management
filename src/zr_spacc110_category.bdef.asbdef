managed implementation in class zbp_r_spacc110_category unique;
strict ( 2 );
with draft;

define behavior for ZR_SPACC110_CATEGORY alias Category
persistent table zspacc110_categ
draft table zspacc110_cate_d
lock master total etag LastChangedAt
authorization master ( none )
{
  create;
  update;
  delete (precheck);

  field ( mandatory : create, readonly : update ) CategoryId;
  field ( mandatory ) CategoryName;
  field ( readonly ) LastChangedAt;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  mapping for zspacc110_categ
  {
    CategoryId   = category_id;
    CategoryName = category_name;
    LastChangedAt = last_changed_at;
  }
}